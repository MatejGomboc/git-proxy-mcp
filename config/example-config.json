{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "_comment": "Example configuration for git-proxy-mcp. Copy to ~/.git-proxy-mcp/config.json and customise.",
    "_note": "This MCP server does NOT store credentials. Configure Git directly using credential helpers and SSH agent.",
    "git_identity": {
        "name": "Claude AI",
        "email": "ai-assistant@your-domain.com"
    },
    "security": {
        "allow_force_push": false,
        "protected_branches": [
            "main",
            "master"
        ],
        "repo_allowlist": null,
        "repo_blocklist": null
    },
    "logging": {
        "level": "warn",
        "audit_log_path": null
    },
    "timeouts": {
        "request_timeout_secs": 300
    },
    "rate_limits": {
        "max_burst": 20,
        "refill_rate_per_sec": 5.0
    },
    "proxy": {
        "url": null,
        "no_proxy": null
    },
    "sessions": {
        "timeout_secs": 3600,
        "max_streaming_sessions": 10,
        "max_repo_sessions": 100
    },
    "lfs": {
        "retry_max_attempts": 3,
        "retry_initial_backoff_ms": 500,
        "retry_max_backoff_ms": 30000,
        "retry_backoff_multiplier": 2.0,
        "max_object_size": null,
        "max_total_size": null
    },
    "submodules": {
        "max_concurrent": 4,
        "max_failures": 3,
        "include_patterns": null,
        "exclude_patterns": null
    }
}
